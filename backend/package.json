{
  "name": "beauty-app-backend",
  "version": "1.0.0",
  "description": "API para Beauty App con geolocalización y auth",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "jest",
    "test:node": "node --test \"src/tests/**/*.nodetest.js\" \"tests/**/*.nodetest.js\" src/tests/adminAuditLog.test.mjs",
    "test:audit-log": "node src/tests/adminAuditLog.test.mjs",
    "migrate": "node -e \"require('./src/models').sequelize.sync({force:true});\"",
    "ingest:rag": "node scripts/ingestBeautyKnowledge.js",
    "purge:rag": "node scripts/purgeRagKnowledge.js",
    "eval:rag": "node scripts/evaluateRag.js",
    "ci:eval": "bash scripts/ciRagEvaluation.sh",
    "smoke:surfaces": "node scripts/smokeSurfaces.js",
    "verify:wompi": "node scripts/verifyWompiCredentials.js",
    "e2e:wompi:sandbox": "node scripts/sandboxWompiE2E.js",
    "openapi:generate": "node scripts/generateOpenApiSpec.js",
    "rag:migrate": "node scripts/runRagMigrations.js",
    "openapi:check": "node scripts/checkOpenApiSpec.js",
    "test:contract": "jest src/tests/contract/openapi.contract.test.js src/tests/contract/critical-endpoints.contract.test.js src/tests/contract/routersMontados.contract.test.js --runInBand --forceExit",
    "e2e": "node scripts/e2e/reglas.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@google/generative-ai": "^0.24.1",
    "@xmldom/xmldom": "^0.8.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.3.2",
    "google-auth-library": "^9.6.3",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "node-forge": "^1.3.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "redis": "^4.6.13",
    "sanitize-html": "2.17.1",
    "sequelize": "^6.37.0",
    "sharp": "^0.35.5",
    "stripe": "^18.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.13.0",
    "ws": "^8.17.0",
    "xmldsigjs": "^2.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pg-mem": "^2.6.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.3.1"
  }
}
